<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Footprint</AssemblyName>
    <RootNamespace>Footprint</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Footprint_Core/Footprint_Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsolatedBootstrapBuild)' == 'true'">
    <ProjectReference Update="../Footprint_Core/Footprint_Core.csproj">
      <AdditionalProperties>PlatformTarget=AnyCPU;BaseOutputPath=$([System.IO.Path]::GetFullPath('$(BaseOutputPath)core/output/'));BaseIntermediateOutputPath=$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)core/intermediate/'));MSBuildProjectExtensionsPath=$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)core/intermediate/'));DefaultItemExcludes=obj/**;IsolatedBootstrapBuild=true</AdditionalProperties>
      <SetPlatform>Platform=AnyCPU</SetPlatform>
    </ProjectReference>
  </ItemGroup>
</Project>
