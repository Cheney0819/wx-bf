<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>Wx411Easy</AssemblyName>
    <RootNamespace>Wx411.Easy</RootNamespace>
    <Product>本地数据读取工具</Product>
    <Description>Windows 本地数据文件恢复与 SQLite 可读副本生成工具</Description>
    <Company>local_data_tools</Company>
    <Version>1.5.0-dev</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <InformationalVersion>1.5.0-dev</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wx411.Core\Wx411.Core.csproj" />
  </ItemGroup>
</Project>
